{
  "name": "caloria-backend",
  "version": "1.0.0",
  "private": true,
  "description": "CALORIA API, Telegram bot and reminder scheduler",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-reporter=spec",
    "check": "node --check src/server.js && node --check src/bot.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.49.4",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2",
    "node-cron": "3.0.3",
    "telegraf": "4.16.3",
    "zod": "3.24.3"
  },
  "devDependencies": {
    "supertest": "7.3.2"
  }
}
