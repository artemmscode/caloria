# ---------------------------------------------------------------------------
# CALORIA backend environment
# Copy this file to backend/.env and fill the values. Never commit real secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# Telegram bot
# Get from @BotFather -> /newbot or /mybots -> API Token
BOT_TOKEN=
# Random long string, used both for the webhook path secret and Telegram's
# X-Telegram-Bot-Api-Secret-Token header. Generate: openssl rand -hex 32
WEBHOOK_SECRET=
# Public HTTPS URL of this Render service, WITHOUT a trailing slash.
# On Render you may leave it empty: RENDER_EXTERNAL_URL is used automatically.
# Example: https://caloria-api.onrender.com
WEBHOOK_URL=
# Public HTTPS URL of the GitHub Pages Mini App, including the repo path.
# Example: https://username.github.io/caloria/
MINI_APP_URL=

# API
API_BASE_URL=http://localhost:3000
# Comma-separated allowed browser origins. Include the GitHub Pages origin.
CORS_ORIGINS=http://localhost:3000,http://localhost:5500
# Long random string used to sign API session tokens (openssl rand -hex 48)
JWT_SECRET=
# Secret for POST /api/cron/tick (openssl rand -hex 32)
CRON_SECRET=
# IANA timezone used for new bot users when Telegram does not provide one.
DEFAULT_TIMEZONE=Asia/Omsk

# Supabase
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
# Supabase → Project Settings → API Keys → Secret key (starts with sb_secret_).
# NEVER expose this in the frontend. It bypasses Row Level Security.
SUPABASE_SECRET_KEY=
# Legacy alternative: the JWT service_role key from older Supabase projects.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional external food database: https://fdc.nal.usda.gov/api-key-signup.html
FOOD_API_KEY=
# Optional AI food photo recognition (OpenAI-compatible endpoint).
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Local development only. Must remain false/unset in production.
ENABLE_DEV_AUTH=true
# If Supabase is not configured, JSON files are stored here (development only).
DEV_DATA_DIR=./.dev-data
